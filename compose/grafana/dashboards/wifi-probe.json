{
  "id": null,
  "uid": "wifi-probe",
  "title": "WiFi Probe",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "Probe Target Status",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "wifi_probe_up{job=\"wifi-probe\"}",
          "legendFormat": "{{probe}} {{target}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Service Up",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "up{job=\"wifi-probe\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Probe Latency (seconds)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "wifi_probe_latency_seconds{job=\"wifi-probe\"}",
          "legendFormat": "{{probe}} {{target}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 }
    },
    {
      "type": "timeseries",
      "title": "Probe Runs Total",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "wifi_probe_runs_total{job=\"wifi-probe\"}",
          "legendFormat": "{{probe}} {{target}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 }
    },
    {
      "type": "timeseries",
      "title": "CPU Usage (cores)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"wifi-probe\"}[1m])",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 22 }
    },
    {
      "type": "timeseries",
      "title": "Memory Usage",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"wifi-probe\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 22 }
    },
    {
      "type": "timeseries",
      "title": "Goroutines",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "go_goroutines{job=\"wifi-probe\"}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 22 }
    },
    {
      "type": "timeseries",
      "title": "Metrics Endpoint Request Rate",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(promhttp_metric_handler_requests_total{job=\"wifi-probe\"}[1m])) by (code)",
          "legendFormat": "HTTP {{code}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 30 }
    }
  ]
}
