{
  "id": null,
  "uid": "wifi-quality-overview",
  "title": "WiFi Quality Overview",
  "description": "Portable overview of WiFi reliability, stability, loss, and user experience signals. Includes host/link indicators for congestion diagnosis; true RF telemetry requires an additional wireless exporter.",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "WiFi Quality Score (15m sustained)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "100 - 45 * (1 - scalar(max(avg_over_time(gateway_reachable{job=\"gateway-monitor\"}[15m])) or vector(0))) - 20 * (1 - scalar(avg(avg_over_time(wifi_probe_up{job=\"wifi-probe\"}[15m])) or vector(0))) - 0.35 * scalar(avg(avg_over_time(network_jitter_ms{job=\"jitter-probe\"}[15m])) or vector(0)) - 0.02 * scalar(avg(avg_over_time(latency_p99{job=\"jitter-probe\"}[15m])) or vector(0)) - 10 * scalar(sum(increase(packet_loss_burst_total{job=\"jitter-probe\"}[15m])) or vector(0))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "green", "value": 90 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Gateway Reachable (5m min)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "min_over_time(gateway_reachable{job=\"gateway-monitor\"}[5m])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 3, "x": 6, "y": 0 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "WiFi Probe Up (5m min)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "min(min_over_time(wifi_probe_up{job=\"wifi-probe\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 3, "x": 9, "y": 0 }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "WAN Reachable (5m min)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "min_over_time(wan_reachable{job=\"gateway-monitor\"}[5m])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 3, "x": 12, "y": 0 }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "LAN Failures (24h)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "scalar(sum(increase(failure_domain_events_total{job=\"gateway-monitor\",domain=\"lan\"}[24h])) or vector(0))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 3, "x": 15, "y": 0 }
    },
    {
