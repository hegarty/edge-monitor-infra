{
  "id": null,
  "uid": "wifi-quality-overview",
  "title": "WiFi Quality Overview",
  "description": "Portable overview of WiFi reliability, stability, loss, and user experience signals.",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "WiFi Quality Score (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "clamp_min(100 - 45 * (1 - min_over_time(gateway_reachable{job=\"gateway-monitor\"}[5m])) - 20 * (1 - min(min_over_time(wifi_probe_up{job=\"wifi-probe\"}[5m]))) - 15 * clamp_max(max(max_over_time(network_jitter_ms{job=\"jitter-probe\"}[5m])) / 30, 1) - 10 * clamp_max(max(max_over_time(latency_p99{job=\"jitter-probe\"}[5m])) / 250, 1) - 10 * clamp_max(sum(increase(packet_loss_burst_total{job=\"jitter-probe\"}[5m])), 1), 0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "green", "value": 90 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Gateway Reachable (5m min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "min_over_time(gateway_reachable{job=\"gateway-monitor\"}[5m])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 3, "x": 6, "y": 0 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "WiFi Probe Up (5m min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "min(min_over_time(wifi_probe_up{job=\"wifi-probe\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 3, "x": 9, "y": 0 }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "WAN Reachable (5m min)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "min_over_time(wan_reachable{job=\"gateway-monitor\"}[5m])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 3, "x": 12, "y": 0 }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "LAN Failures (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "increase(failure_domain_events_total{job=\"gateway-monitor\",domain=\"lan\"}[24h])",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 3, "x": 15, "y": 0 }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Loss Bursts (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(packet_loss_burst_total{job=\"jitter-probe\"}[1h]))",
          "refId": "A"
