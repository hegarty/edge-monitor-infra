{
  "id": null,
  "uid": "jitter-probe",
  "title": "Jitter Probe",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "Probe Up",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "up{job=\"jitter-probe\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Packet Loss Total",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(packet_loss_total{job=\"jitter-probe\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Targets Monitored",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "count(network_latency_ms{job=\"jitter-probe\"})",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Network Latency (ms)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "network_latency_ms{job=\"jitter-probe\"}",
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }
    },
    {
      "type": "timeseries",
      "title": "Network Jitter (ms)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "network_jitter_ms{job=\"jitter-probe\"}",
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }
    },
    {
      "type": "timeseries",
      "title": "Latency Percentiles (ms)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "latency_p95{job=\"jitter-probe\"}",
          "legendFormat": "p95 {{target}}",
          "refId": "A"
        },
        {
          "expr": "latency_p99{job=\"jitter-probe\"}",
          "legendFormat": "p99 {{target}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 }
    },
    {
      "type": "timeseries",
      "title": "CPU Usage (cores)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"jitter-probe\"}[1m])",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 22 }
    },
    {
      "type": "timeseries",
      "title": "Memory Usage",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"jitter-probe\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 22 }
    },
    {
      "type": "timeseries",
      "title": "Goroutines",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "go_goroutines{job=\"jitter-probe\"}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 22 }
    },
    {
      "type": "timeseries",
      "title": "Metrics Endpoint Request Rate",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(promhttp_metric_handler_requests_total{job=\"jitter-probe\"}[1m])) by (code)",
          "legendFormat": "HTTP {{code}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 30 }
    }
  ]
}
