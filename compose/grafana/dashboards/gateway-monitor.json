{
  "id": null,
  "uid": "gateway-monitor",
  "title": "Gateway Monitor",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "Gateway Reachable",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "gateway_reachable{job=\"gateway-monitor\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "WAN Reachable",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "wan_reachable{job=\"gateway-monitor\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Service Up",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "up{job=\"gateway-monitor\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Failure Domain Events",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "failure_domain_events_total{job=\"gateway-monitor\"}",
          "legendFormat": "{{domain}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 }
    },
    {
      "type": "timeseries",
      "title": "CPU Usage (cores)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"gateway-monitor\"}[1m])",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 }
    },
    {
      "type": "timeseries",
      "title": "Memory Usage",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"gateway-monitor\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 }
    },
    {
      "type": "timeseries",
      "title": "Goroutines",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "go_goroutines{job=\"gateway-monitor\"}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 }
    },
    {
      "type": "timeseries",
      "title": "Metrics Endpoint Request Rate",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(promhttp_metric_handler_requests_total{job=\"gateway-monitor\"}[1m])) by (code)",
          "legendFormat": "HTTP {{code}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 }
    }
  ]
}
